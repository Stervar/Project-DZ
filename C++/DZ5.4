#include <iostream>
#include <windows.h>
using namespace std;



int main() {
    SetConsoleCP(65001);
    SetConsoleOutputCP(65001);

    int num;
    double exponent;
    double result = pow(num, exponent);

    cout << "Введите основание числа: " << endl;
    cin >> num;

    cout << "Введите степень числа: " << endl;
    cin >> exponent;

    cout << num << "^" << exponent << " = " << result << endl;

    return 0;


